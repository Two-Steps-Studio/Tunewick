{
  "name": "tunewick",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --filter @tunewick/web dev",
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "e2e": "pnpm --filter @tunewick/web e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "fontkit": "^2.0.4",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "supabase": "^2.119.0",
    "wawoff2": "^2.0.1"
  }
}
