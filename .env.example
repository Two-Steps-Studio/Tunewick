# Copy to apps/web/.env.local (or run `pnpm db:env` with local Supabase running).
# Never commit real values. Only NEXT_PUBLIC_* variables reach the browser.

# Supabase project URL and publishable (client-safe) key.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secrets are added by the tasks that need them (never NEXT_PUBLIC_*).
