# Copy to apps/web/.env.local (or run `pnpm db:env` with local Supabase running).
# Never commit real values. Only NEXT_PUBLIC_* variables reach the browser.

# Supabase project URL and publishable (client-safe) key.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secrets are added by the tasks that need them (never NEXT_PUBLIC_*).

# Audio upload: S3-compatible storage (Cloudflare R2 in production; `pnpm media:start` locally).
# Leave empty to show the upload as "not available yet". Server-only.
MEDIA_S3_ENDPOINT=
MEDIA_S3_REGION=auto
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_INGEST_BUCKET=
# Delivery variants written by the audio worker (members preview them via short-lived URLs).
MEDIA_BUCKET=
