# Dependencies
node_modules/
.pnpm-store/

# Builds
.next/
out/
dist/
build/
coverage/
*.tsbuildinfo

# Environment / secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key

# Supabase local
supabase/.temp/
supabase/.branches/

# Audio working files (masters are never stored in git)
*.wav
*.flac
*.aiff
*.mp3
*.m4a
*.opus
tools/playback-spike/media/

# OS / editors
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/

# Logs
*.log
npm-debug.log*

# Vercel
.vercel

# Agent skill symlinks (regenerated by `npx skills add emilkowalski/skill`; sources in .agents/skills)
.claude/skills/
.claude/settings.local.json

# Test output
playwright-report/
test-results/

# Logo review previews (regenerated by design/logo/build-logo.mjs)
design/logo/preview-*.png

# Playback spike runner output
tools/playback-spike/test-results/

# Python (audio worker)
__pycache__/
.pytest_cache/
.ruff_cache/
.venv/

# Tiny capability-probe files are part of the app (scripts/generate-probe-media.mjs)
!apps/web/public/player-probe/*
# Dev/test album produced by the audio worker (pnpm dev:media)
apps/web/public/dev-media/
